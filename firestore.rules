rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if false;
    }

    match /categorias/{categoryId} {
      allow read, write: if false;
    }

    match /categorias_nombres/{nameKey} {
      allow read, write: if false;
    }

    match /fabricantes/{manufacturerId} {
      allow read, write: if false;
    }

    match /fabricantes_nombres/{nameKey} {
      allow read, write: if false;
    }

    match /modelos_activos/{modelId} {
      allow read, write: if false;
    }

    match /modelos_activos_claves/{keyId} {
      allow read, write: if false;
    }

    match /campus/{campusId} {
      allow read, write: if false;
    }

    match /campus_claves/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
