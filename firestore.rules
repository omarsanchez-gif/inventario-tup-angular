rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if false;
    }

    match /categorias/{categoryId} {
      allow read, write: if false;
    }

    match /categorias_nombres/{nameKey} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
