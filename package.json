{
  "name": "inventario-tup-angular",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:staging": "ng serve --configuration staging",
    "build": "ng build",
    "build:staging": "ng build --configuration staging",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "functions:build": "npm --workspace functions run build",
    "test:functions": "vitest run functions/src",
    "test:categories:emulator": "firebase emulators:exec --only firestore --project demo-inventario-tup \"vitest run functions/src/categories-firestore.spec.ts\"",
    "test:emulators": "npm run functions:build && firebase emulators:exec --only auth,firestore,functions --project demo-inventario-tup \"vitest run --no-file-parallelism functions/src/categories-firestore.spec.ts functions/src/manufacturers-firestore.spec.ts functions/src/users-emulator.spec.ts\"",
    "lint": "ng lint && npm run lint:functions && npm run lint:visual",
    "lint:functions": "eslint functions/src --max-warnings=0",
    "lint:visual": "node scripts/check-visual-primitives.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firebase:emulators": "firebase emulators:start --project demo-inventario-tup"
  },
  "private": true,
  "workspaces": [
    "functions"
  ],
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "google-gax@5.0.8": {
      "google-auth-library": "10.9.1"
    }
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "firebase-tools": "^15.27.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^5.0.0"
  }
}
